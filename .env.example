# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Airflow web UI credentials
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=changeme

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# Connection string used by export_to_postgres.py (matches the above)
POSTGRES_DSN=postgresql://airflow:changeme@postgres/airflow

# ── Metabase ──────────────────────────────────────────────────────────────────
# Set before running scripts/create_metabase_dashboards.py
METABASE_TOKEN=
METABASE_DB_ID=
METABASE_COLLECTION_ID=

# ── Data paths (used by Python scripts outside Docker) ────────────────────────
DATA_DIR=data
RAW_DIR=data/raw
WAREHOUSE_PATH=data/warehouse.duckdb

# ── ANRT CKAN API ─────────────────────────────────────────────────────────────
ANRT_BASE_URL=https://data.gov.ma/data/api/3/action/

# ── ITU DataHub ───────────────────────────────────────────────────────────────
ITU_BASE_URL=https://datahub.itu.int/
